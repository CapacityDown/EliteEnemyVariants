<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>EliteEnemyVariants</AssemblyName>
    <RootNamespace>REPOJP.EliteEnemyVariants</RootNamespace>
    <Authors>REPOJP</Authors>
    <Version>5.0.0</Version>
    <CopyFilesToPluginOutputDirectoryOnBuild>false</CopyFilesToPluginOutputDirectoryOnBuild>
    <CopyFilesToPluginOutputDirectoryOnRun>false</CopyFilesToPluginOutputDirectoryOnRun>
  </PropertyGroup>

  <Import Project="Directory.Repo.props" Condition="Exists('Directory.Repo.props')" />

  <PropertyGroup>
    <RepoGamePath Condition="'$(RepoGamePath)' == ''">$(REPO_GAME_DIR)</RepoGamePath>
    <GameManagedDir>$(RepoGamePath)\REPO_Data\Managed</GameManagedDir>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.windows10ce.com/nuget/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MenuLib">
      <HintPath>lib\MenuLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Compile Remove="checks/**/*.cs" />
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" ExcludeAssets="runtime" />
    <Compile Remove="outputs/**/*.cs;Deployments/**/*.cs" />
    <!-- Compile against the shipped Unity 6/game API, never the publicized 0.4 references. -->
    <Reference Include="$(GameManagedDir)\Assembly-CSharp.dll;$(GameManagedDir)\Assembly-CSharp-firstpass.dll;$(GameManagedDir)\Photon*.dll;$(GameManagedDir)\Unity*.dll;$(GameManagedDir)\Facepunch.Steamworks.Win64.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequireInstalledGame" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameManagedDir)\Assembly-CSharp.dll')" Text="Set RepoGamePath (-p:RepoGamePath=... or Directory.Repo.props) to the R.E.P.O. v0.5.0 installation." />
  </Target>

</Project>
